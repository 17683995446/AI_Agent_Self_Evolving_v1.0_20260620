# 自驱永续进化Agent系统 —— 环境变量配置模板
# 复制为 .env 并按需修改：cp .env.example .env

# Agent 运行环境
AGENT_ENV=prod

# 端口配置
AGENT_REST_PORT=9090
AGENT_DASHBOARD_PORT=8080

# 监控栈端口（仅在使用 --profile monitoring 时生效）
PROMETHEUS_PORT=9091
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# systemd 部署专用（部署到 /etc/systemd/system/ 时使用）
# SERVICE_USER=root
# SERVICE_GROUP=root
# AGENT_DIR=/opt/self-evolving-agent
# PYTHON_BIN=/usr/bin/python3
